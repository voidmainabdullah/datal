# Server-side secrets. Add these as Whop app secrets (never in client code, never with a VITE_ or NEXT_PUBLIC_ prefix).
GEMINI_API_KEY=                 # required for AI generation (Google AI Studio key; use a freshly rotated key)

# Optional model selection (defaults are Gemini free-tier models)
GENIUS_MODEL_FAST=gemini-3.5-flash-lite
GENIUS_MODEL_STRONG=gemini-3.8-flash
GENIUS_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.1-flash-lite   # tried only if a model's daily quota is spent or its id is unknown
GENIUS_MODEL_FAST_THINKING=low       # minimal|low|medium|high|off
GENIUS_MODEL_STRONG_THINKING=medium

# Free-tier budgeting (Google counts per project; set these from the AI Studio rate-limit page)
GEMINI_RPM_LIMIT=10
GEMINI_TPM_LIMIT=250000
GEMINI_RPD_LIMIT=250
GENIUS_INPUT_TOKEN_BUDGET=120000

# DeepSeek: OFF by default and never a fallback. Enabled only when ALL THREE are set.
# GENIUS_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_ALLOW_PAID_USAGE=true    # you accept that requests may be charged (or you confirmed a granted, no-cost balance)
